    # ==========================================
    # Database Helper Methods
    # ==========================================
    def _has_claimed_trial(self, db: Session, email: str) -> bool:
        """Checks if an email has ever claimed a free trial using TrialLog."""
        return db.query(TrialLog).filter(TrialLog.email == email.lower()).first() is not None

    def _log_trial_claim(self, db: Session, email: str):
        """Records an email permanently in the trial log."""
        log_entry = TrialLog(email=email.lower(), timestamp=time.time())
        db.add(log_entry)
        db.commit()

    def _add_to_waitlist(self, db: Session, email: str):
        """Appends an email entry to the waitlist table."""
        entry = Waitlist(email=email, timestamp=time.time())
        db.add(entry)
        db.commit()

    def _log_churn_feedback(self, db: Session, user_id: str, reason: str, comments: str):
        """Records account cancellation survey responses."""
        feedback = ChurnFeedback(user_id=user_id, reason=reason, comments=comments, timestamp=time.time())
        db.add(feedback)
        db.commit()

    def _log_api_usage(self, db: Session, user_id: str):
        """Logs API access activity."""
        log = UsageLog(user_id=user_id, timestamp=time.time())
        db.add(log)
        db.commit()

