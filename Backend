    def enroll_confirm_handler(self, user_id: str = Form(...), db: Session = Depends(get_db)):
        user = db.query(User).filter(User.user_id == user_id).first()
        if not user:
            raise HTTPException(status_code=404, detail="User not found.")

        has_claimed = self._has_claimed_trial(db, user.email)

        if not has_claimed:
            self._log_trial_claim(db, user.email)
            next_bill_dt = datetime.now() + timedelta(days=30)
            bill_date = next_bill_dt.strftime("%Y-%m-%d")
        else:
            bill_date = time.strftime("%Y-%m-%d")
            try:
                stripe.PaymentIntent.create(
                    amount=40000,
                    currency="usd",
                    payment_method_types=["card"],
                    description=f"Standard Monthly Subscription Charge for {user.username}"
                )
            except Exception:
                pass

        user.enrolled = True
        user.bill_date = bill_date
        db.commit()

        return RedirectResponse(url=f"/web4?user_id={user_id}", status_code=303)

