# ==========================================
# 1. Database Configuration & ORM Models
# ==========================================
DATABASE_URL = "sqlite:///./app_backend.db"  # Swap with postgresql://user:pass@host/db in production

engine = create_engine(DATABASE_URL, connect_args={"check_same_thread": False} if "sqlite" in DATABASE_URL else {})
SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)
Base = declarative_base()

# Security Setup: Password Hashing via Argon2id
password_hash = PasswordHash((Argon2Hasher(),))


class User(Base):
    __tablename__ = "users"

    user_id = Column(String, primary_key=True, index=True)
    username = Column(String, unique=True, index=True, nullable=False)
    password_hash = Column(String, nullable=False)
    email = Column(String, unique=True, index=True, nullable=False)
    card_last4 = Column(String, default="")  # Storing only last 4 for PCI compliance
    exp_date = Column(String, default="")
    enrolled = Column(Boolean, default=False)
    bill_date = Column(String, default="")
    created_at = Column(DateTime, default=datetime.utcnow)


class TrialLog(Base):
    __tablename__ = "trial_logs"

    id = Column(Integer, primary_key=True, autoincrement=True)
    email = Column(String, unique=True, index=True, nullable=False)
    timestamp = Column(Float, default=time.time)


class Waitlist(Base):
    __tablename__ = "waitlist"

    id = Column(Integer, primary_key=True, autoincrement=True)
    email = Column(String, index=True, nullable=False)
    timestamp = Column(Float, default=time.time)


class ChurnFeedback(Base):
    __tablename__ = "churn_feedback"

    id = Column(Integer, primary_key=True, autoincrement=True)
    user_id = Column(String, nullable=False)
    reason = Column(String, nullable=False)
    comments = Column(Text, nullable=True)
    timestamp = Column(Float, default=time.time)


class UsageLog(Base):
    __tablename__ = "usage_logs"

    id = Column(Integer, primary_key=True, autoincrement=True)
    user_id = Column(String, nullable=False)
    timestamp = Column(Float, default=time.time)


# Create schema tables if they don't exist
Base.metadata.create_all(bind=engine)


# Database Session Dependency
def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


