    def web3_signup_handler(self, username: str = Form(...), password: str = Form(...),
                            confirm_password: str = Form(...), email: str = Form(...),
                            card_number: str = Form(""), exp_date: str = Form("09/29"),
                            csv: str = Form("445"), db: Session = Depends(get_db)):
        if db.query(User).count() >= 1500:
            return HTMLResponse(content=self.web3_signup_page(db=db), status_code=200)

        if password != confirm_password:
            return HTMLResponse(content=self.web3_signup_page(error="Passwords do not match!", db=db), status_code=400)

        if db.query(User).filter(User.username == username).first():
            return HTMLResponse(content=self.web3_signup_page(error="Username already exists!", db=db), status_code=400)

        user_id = f"usr_{int(time.time())}"
        hashed_password = password_hash.hash(password)
        card_last4 = card_number[-4:] if len(card_number) >= 4 else "0000"

        new_user = User(
            user_id=user_id,
            username=username,
            password_hash=hashed_password,
            email=email,
            card_last4=card_last4,
            exp_date=exp_date if exp_date else "09/29",
            enrolled=False,
            bill_date=""
        )
        db.add(new_user)
        db.commit()

        return RedirectResponse(url=f"/enroll?user_id={user_id}", status_code=303)

