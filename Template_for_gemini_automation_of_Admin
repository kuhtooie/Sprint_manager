def setup_trading_engine_files(base_dir="Trading_Engine", schedule_folder="employee_schedules", mark_completed=True):
    modules = ["__init__.py", "Main.py", "BackTest.py", "Data.py", "Live.py", "Admin.py", "employees_config.py"]
    
    if not os.path.exists(base_dir):
        os.makedirs(base_dir)
    
    for mod in modules:
        path = os.path.join(base_dir, mod)
        if not os.path.exists(path):
            with open(path, "w", encoding="utf-8") as f:
                if mod == "employees_config.py":
                    f.write("EMPLOYEE_MANIFEST = " + repr(EMPLOYEE_MANIFEST))
                else:
                    f.write(f"# Module: {mod}\n")

    target_path = os.path.join(base_dir, schedule_folder)
    if not os.path.exists(target_path):
        os.makedirs(target_path)

    employee_names = list(EMPLOYEE_MANIFEST.keys())

    # Generate master names.csv for Administrator.py roster detection
    names_df = pd.DataFrame(employee_names, columns=['EmployeeName'])
    names_df.to_csv(os.path.join(target_path, "names.csv"), index=False, encoding="utf-8")

    # Status: 1 marks the task as Completed ("Completed"), 0 marks it as To-Do
    status_value = 1 if mark_completed else 0

    for emp, info in EMPLOYEE_MANIFEST.items():
        payload = []
        for task in info['tasks']:
            payload.append({
                "Task": task,
                "Value": info['role'],
                "Status": status_value  # Explicitly completed (1) or pending (0)
            })
        df = pd.DataFrame(payload)
        df.to_csv(os.path.join(target_path, f"{emp}.csv"), index=False, encoding="utf-8")

    print(f"[SUCCESS] Directory structure and status-tracked CSVs deployed under: {os.path.abspath(base_dir)}")

if __name__ == "__main__":
    # Set mark_completed=True to designate all tasks as successfully completed (1)
    # Set mark_completed=False if you want them treated as uncompleted to-dos (0)
    setup_trading_engine_files(mark_completed=True)
