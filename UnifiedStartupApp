import tkinter as tk
from tkinter import messagebox


class UnifiedStartupApp:

    def __init__(self, root):
        self.root = root
        self.root.title("Unified Startup Valuation & Financial Suite")
        self.root.geometry("750x720")
        self.root.config(bg="#f4f6f9")

        self.current_mode = "valuation"

        # Top Navigation Frame for Toggle
        nav_frame = tk.Frame(root, bg="#f4f6f9")
        nav_frame.pack(pady=10)

        self.toggle_btn = tk.Button(
            nav_frame,
            text="Switch to: Quarterly Financial Health Tracker",
            command=self.toggle_mode,
            font=("Arial", 10, "bold"),
            bg="#34495e",
            fg="white",
            padx=10,
            pady=5,
        )
        self.toggle_btn.pack()

        # Title
        self.title_label = tk.Label(
            root,
            text="Private Company Share Price & Valuation Engine",
            font=("Arial", 14, "bold"),
            bg="#f4f6f9",
            fg="#2c3e50",
        )
        self.title_label.pack(pady=10)

        # Input Frame Container
        self.container_frame = tk.Frame(root, bg="#f4f6f9")
        self.container_frame.pack(padx=20, fill="x")

        # Output Results Area
        self.output_frame = tk.Frame(root, bg="#ffffff", bd=2, relief="groove")
        self.output_frame.pack(padx=20, fill="both", expand=True, pady=10)

        self.result_label = tk.Label(
            self.output_frame,
            text="Click 'Compute' to calculate metrics...",
            font=("Arial", 10),
            bg="#ffffff",
            justify="left",
            anchor="nw",
        )
        self.result_label.pack(fill="both", expand=True, padx=15, pady=15)

        # Build initial view
        self.fields = {}
        self.build_valuation_ui()

    def clear_container(self):
        for widget in self.container_frame.winfo_children():
            widget.destroy()
        self.fields.clear()

    def toggle_mode(self):
        if self.current_mode == "valuation":
            self.current_mode = "quarterly"
            self.toggle_btn.config(
                text="Switch to: Valuation & Share Price Calculator"
            )
            self.title_label.config(text="Startup Q-Report & P/E Dashboard")
            self.build_quarterly_ui()
        else:
            self.current_mode = "valuation"
            self.toggle_btn.config(
                text="Switch to: Quarterly Financial Health Tracker"
            )
            self.title_label.config(
                text="Private Company Share Price & Valuation Engine"
            )
            self.build_valuation_ui()
        self.result_label.config(
            text="Click 'Compute' to calculate metrics..."
        )

    def build_valuation_ui(self):
        self.clear_container()
        defaults = {
            "Latest Post-Money Valuation ($)": "5000000",
            "Total Fully Diluted Shares": "1000000",
            "Annual Revenue ($)": "600000",
            "Industry Average P/E Multiple": "15.0",
            "Net Income (Trailing Q) ($)": "25000",
        }

        row_idx = 0
        for label_text, default_val in defaults.items():
            lbl = tk.Label(
                self.container_frame,
                text=label_text,
                font=("Arial", 10, "bold"),
                bg="#f4f6f9",
                anchor="w",
            )
            lbl.grid(row=row_idx, column=0, sticky="w", pady=4, padx=5)

            entry = tk.Entry(self.container_frame, width=18, font=("Arial", 10))
            entry.insert(0, default_val)
            entry.grid(row=row_idx, column=1, pady=4, padx=5)

            self.fields[label_text] = entry
            row_idx += 1

        # Calculate Button
        if hasattr(self, "calc_btn") and self.calc_btn.winfo_exists():
            self.calc_btn.destroy()

        self.calc_btn = tk.Button(
            self.container_frame,
            text="Compute Implied Share Price & Metrics",
            command=self.compute_private_valuation,
            font=("Arial", 11, "bold"),
            bg="#2980b9",
            fg="white",
            padx=10,
            pady=5,
        )
        self.calc_btn.grid(
            row=row_idx, column=0, columnspan=2, pady=15
        )

    def build_quarterly_ui(self):
        self.clear_container()
        defaults = {
            "Quarterly Revenue ($)": "150000",
            "Quarterly Operating Expenses ($)": "220000",
            "Total Cash Balance ($)": "600000",
            "Current Share Price ($)": "12.50",
            "Total Shares Outstanding": "500000",
            "Net Income (Trailing Q) ($)": "25000",
        }

        row_idx = 0
        for label_text, default_val in defaults.items():
            lbl = tk.Label(
                self.container_frame,
                text=label_text,
                font=("Arial", 10, "bold"),
                bg="#f4f6f9",
                anchor="w",
            )
            lbl.grid(row=row_idx, column=0, sticky="w", pady=4, padx=5)

            entry = tk.Entry(self.container_frame, width=15, font=("Arial", 10))
            entry.insert(0, default_val)
            entry.grid(row=row_idx, column=1, pady=4, padx=5)

            self.fields[label_text] = entry
            row_idx += 1

        # Calculate Button
        if hasattr(self, "calc_btn") and self.calc_btn.winfo_exists():
            self.calc_btn.destroy()

        self.calc_btn = tk.Button(
            self.container_frame,
            text="Compute Financials & P/E",
            command=self.compute_metrics,
            font=("Arial", 11, "bold"),
            bg="#27ae60",
            fg="white",
            padx=10,
            pady=5,
        )
        self.calc_btn.grid(
            row=row_idx, column=0, columnspan=2, pady=15
        )

    def compute_private_valuation(self):
        try:
            valuation = float(
                self.fields["Latest Post-Money Valuation ($)"].get()
            )
            shares = float(self.fields["Total Fully Diluted Shares"].get())
            revenue = float(self.fields["Annual Revenue ($)"].get())
            pe_multiple = float(
                self.fields["Industry Average P/E Multiple"].get()
            )
            net_income = float(
                self.fields["Net Income (Trailing Q) ($)"].get()
            )

            if shares <= 0:
                messagebox.showerror(
                    "Error", "Total shares must be greater than zero."
                )
                return

            implied_share_price = valuation / shares
            annualized_net_income = net_income * 4
            earnings_based_market_cap = annualized_net_income * pe_multiple
            earnings_share_price = (
                earnings_based_market_cap / shares
                if annualized_net_income > 0
                else 0.0
            )
            rev_multiple = valuation / revenue if revenue > 0 else 0

            output_text = (
                f"--- PRIVATE COMPANY SHARE PRICE BREAKDOWN ---\n\n"
                f"• Valuation-Derived Share Price: ${implied_share_price:,.4f}\n"
                f"  (Formula: Latest Post-Money Valuation / Total Diluted Shares)\n\n"
                f"• Earnings-Derived Share Price: ${earnings_share_price:,.4f}\n"
                f"  (Formula: [Annualized Net Income × Industry P/E] / Shares)\n\n"
                f"• Implied Revenue Multiple: {rev_multiple:.2f}x\n"
                f"  (Post-Money Valuation / Annual Revenue)\n\n"
                f"Note: Private startups rely heavily on 409A valuations, "
                f"priced equity rounds, or option pool allocations."
            )

            self.result_label.config(text=output_text)

        except ValueError:
            messagebox.showerror(
                "Error", "Please enter valid numerical inputs."
            )

    def compute_metrics(self):
        try:
            rev = float(self.fields["Quarterly Revenue ($)"].get())
            opex = float(
                self.fields["Quarterly Operating Expenses ($)"].get()
            )
            cash = float(self.fields["Total Cash Balance ($)"].get())
            price = float(self.fields["Current Share Price ($)"].get())
            shares = float(self.fields["Total Shares Outstanding"].get())
            net_income = float(
                self.fields["Net Income (Trailing Q) ($)"].get()
            )

            net_burn = opex - rev
            runway_months = (
                (cash / net_burn) * 3 if net_burn > 0 else float("inf")
            )

            market_cap = price * shares
            annualized_net_income = net_income * 4
            eps = annualized_net_income / shares if shares > 0 else 0
            pe_ratio = price / eps if eps > 0 else "N/A (Unprofitable)"

            runway_str = (
                f"{runway_months:.1f} months"
                if net_burn > 0
                else "Infinite (Cash Flow Positive!)"
            )
            pe_str = (
                f"{pe_ratio:.2f}"
                if isinstance(pe_ratio, float)
                else pe_ratio
            )

            output_text = (
                f"--- STARTUP FINANCIAL HEALTH REPORT ---\n\n"
                f"• Net Quarterly Burn Rate: ${net_burn:,.2f}\n"
                f"• Estimated Runway: {runway_str}\n"
                f"• Market Capitalization: ${market_cap:,.2f}\n"
                f"• Annualized EPS: ${eps:.2f}\n"
                f"• Calculated P/E Ratio: {pe_str}"
            )

            self.result_label.config(text=output_text)

        except ValueError:
            messagebox.showerror(
                "Error", "Please enter valid numerical inputs."
            )


if __name__ == "__main__":
    root = tk.Tk()
    app = UnifiedStartupApp(root)
    root.mainloop()
    
